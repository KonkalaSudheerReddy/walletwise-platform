              "listen": "prerequest",
              "script": {
                "exec": [
                  "const now = new Date();",
                  "const month = `${now.getUTCFullYear()}-${String(now.getUTCMonth() + 1).padStart(2, '0')}`;",
                  "pm.collectionVariables.set('budgetMonth', month);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Budget is created', function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.collectionVariables.set('budgetId', pm.response.json().id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"{{expenseCategoryId}}\",\n  \"month\": \"{{budgetMonth}}\",\n  \"limitAmount\": 400.00,\n  \"alertThresholdPercent\": 80\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/budgets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "budgets"]
            }
          }
        },
        {
          "name": "Monthly analytics",
          "request": {
            "method": "GET",
            "header": [],
