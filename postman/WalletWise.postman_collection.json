    {
      "name": "05 - Idempotent transfer",
      "item": [
        {
          "name": "Create transfer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Transfer is created once', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const transfer = pm.response.json();",
                  "  pm.expect(transfer.status).to.eql('COMPLETED');",
                  "  pm.collectionVariables.set('transferId', transfer.id);",
                  "  pm.collectionVariables.set('transferResponse', JSON.stringify(transfer));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceWalletId\": \"{{sourceWalletId}}\",\n  \"destinationWalletId\": \"{{destinationWalletId}}\",\n  \"amount\": 125.00,\n  \"note\": \"Postman idempotency example\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transfers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transfers"]
            }
          }
        },
        {
          "name": "Retry identical transfer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceWalletId\": \"{{sourceWalletId}}\",\n  \"destinationWalletId\": \"{{destinationWalletId}}\",\n  \"amount\": 125.00,\n  \"note\": \"Postman idempotency example\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transfers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transfers"]
            },
            "description": "An identical retry replays the original 201 response without another movement."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Identical retry replays the original result', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const replay = pm.response.json();",
                  "  pm.expect(replay.id).to.eql(pm.collectionVariables.get('transferId'));",
                  "  pm.expect(JSON.stringify(replay)).to.eql(pm.collectionVariables.get('transferResponse'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject conflicting key reuse",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceWalletId\": \"{{sourceWalletId}}\",\n  \"destinationWalletId\": \"{{destinationWalletId}}\",\n  \"amount\": 126.00,\n  \"note\": \"Postman idempotency example\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transfers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transfers"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Different body with the same key conflicts', function () {",
                  "  pm.response.to.have.status(409);",
                  "  pm.expect(pm.response.json().status).to.eql(409);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "06 - Search, budgets, and analytics",
      "item": [
        {
          "name": "Filtered paginated transactions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions?walletId={{sourceWalletId}}&minAmount=20.00&description=Postman&page=0&size=20&sort=occurredAt&direction=desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transactions"],
              "query": [
                { "key": "walletId", "value": "{{sourceWalletId}}" },
                { "key": "minAmount", "value": "20.00" },
                { "key": "description", "value": "Postman" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "sort", "value": "occurredAt" },
                { "key": "direction", "value": "desc" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Page metadata and filtered content are returned', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const page = pm.response.json();",
                  "  pm.expect(page.content).to.be.an('array');",
                  "  pm.expect(page.page).to.eql(0);",
                  "  pm.expect(page.size).to.eql(20);",
                  "});"
                ]
