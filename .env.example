# Local PostgreSQL configuration. These values are development-only.
POSTGRES_DB=walletwise
POSTGRES_USER=walletwise
POSTGRES_PASSWORD=walletwise_dev_only

# Spring application configuration.
SPRING_PROFILES_ACTIVE=dev,demo
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/walletwise
SPRING_DATASOURCE_USERNAME=walletwise
SPRING_DATASOURCE_PASSWORD=walletwise_dev_only
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
APP_COOKIE_SECURE=false
APP_DEMO_SEED_ENABLED=true
APP_PUBLIC_URL=http://localhost:8080
APP_REFRESH_REUSE_GRACE=PT3S

# Documented local-only value. Production rejects this prefix; replace it with
# at least 32 unpredictable characters in a provider secret store.
JWT_SECRET=local-development-only-walletwise-secret-change-me-2026

# Optional local administrator seed. Leave blank to disable it.
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

# Runtime ports and frontend development configuration.
PORT=8080
APP_PORT=8080
POSTGRES_PORT=5432
VITE_API_BASE_URL=
