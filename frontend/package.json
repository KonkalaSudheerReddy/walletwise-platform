    "clsx": "2.1.1",
    "lucide-react": "0.511.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "7.57.0",
    "react-router-dom": "7.6.2",
    "recharts": "2.15.3",
    "sonner": "2.0.5",
    "tailwind-merge": "3.3.0",
    "zod": "3.25.64"
