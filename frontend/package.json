    "lucide-react": "0.511.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.84.0",
    "react-router-dom": "7.18.2",
    "recharts": "2.15.3",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "zod": "3.25.64"
